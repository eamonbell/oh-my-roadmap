{
	"name": "oh-my-roadmap-monorepo",
	"version": "0.8.0",
	"description": "Monorepo for oh-my-roadmap: the OMP extension, the omr-cli tool, and their shared core.",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "tsc --noEmit",
		"build": "bun run --filter omr-cli build",
		"test": "bun test",
		"verify": "bun run check && bun test"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
