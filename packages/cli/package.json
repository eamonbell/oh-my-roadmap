{
	"name":            "@oh-my-roadmap/cli",
	"version":         "1.2.0",
	"description":     "CLI for oh-my-roadmap: scaffold project config and (re)generate agent definitions from config models.",
	"type":            "module",
	"license":         "MIT",
	"bin":             {
		"omr": "dist/index.js"
	},
	"files":           [
		"dist"
	],
	"scripts":         {
		"build":  "rm -rf ./dist && bun build ./src/index.ts --target node --outfile ./dist/index.js && chmod +x ./dist/index.js",
		"link":   "bun run build && bun link",
		"unlink": "bun unlink"
	},
	"devDependencies": {
		"@oh-my-roadmap/core": "1.2.0"
	},
	"engines":         {
		"node": ">=18"
	},
	"publishConfig":   {
		"access": "public"
	},
	"dependencies":    {
		"@clack/prompts": "^1.7.0",
		"commander":      "^15.0.0"
	}
}
