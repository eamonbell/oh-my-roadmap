{
	"name":             "@oh-my-roadmap/plugin",
	"version":          "1.2.0",
	"description":      "OMP extension for roadmap-based planning, milestone orchestration, worker notes, and gated complex implementation workflows.",
	"type":             "module",
	"license":          "MIT",
	"omp":              {
		"extensions": [
			"./src/main.ts"
		],
		"hooks":      "./hooks/pre/roadmap-gate.ts"
	},
	"files":            [
		"src",
		"hooks",
		"prompts",
		"skills"
	],
	"dependencies":     {
		"@oh-my-roadmap/core": "1.2.0"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^16.2.6",
		"@oh-my-pi/pi-tui":          "^16.2.6"
	},
	"devDependencies":  {
		"@oh-my-pi/pi-coding-agent": "16.2.6",
		"@oh-my-pi/pi-tui":          "16.2.6"
	},
	"engines":          {
		"bun": ">=1.3.14"
	},
	"publishConfig":    {
		"access": "public"
	}
}
