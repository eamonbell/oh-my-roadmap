{
	"name":             "@oh-my-roadmap/plugin",
	"version":          "2.0.0",
	"description":      "OMP extension for roadmap-based planning, milestone orchestration, worker notes, and gated complex implementation workflows.",
	"type":             "module",
	"license":          "MIT",
	"omp":              {
		"extensions": [
			"./src/main.ts"
		],
		"hooks":      "./hooks/pre/roadmap-gate.ts"
	},
	"files":            [
		"src",
		"hooks",
		"prompts",
		"skills"
	],
	"dependencies":     {
		"@oh-my-roadmap/core": "workspace:*"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^17.0.0",
		"@oh-my-pi/pi-tui":          "^17.0.0"
	},
	"devDependencies":  {
		"@oh-my-pi/pi-coding-agent": "17.0.7",
		"@oh-my-pi/pi-tui":          "17.0.7"
	},
	"engines":          {
		"bun": ">=1.3.14"
	},
	"publishConfig":    {
		"access": "public"
	}
}
